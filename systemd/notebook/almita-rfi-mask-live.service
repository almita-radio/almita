[Unit]
Description=ALMITA live RFI masks of MAIN for the monitor (RFI MASK panel, UNKNOWN PLEASURES) - read-only
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=@USER@
WorkingDirectory=@ROOT@
ExecStart=@ROOT@/.venv/bin/python @ROOT@/rfi_mask_live.py
KillSignal=SIGINT
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
