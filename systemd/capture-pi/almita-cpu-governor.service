[Unit]
Description=ALMITA capture Pi: fixed CPU clock (powersave, 600 MHz on a Pi 4) - the ondemand clock changes radiated RF pulses into MAIN
# 2026-11-02 indoor tests in the box: ondemand -> pulses in 7-8 % of the FFT frames and a ~1421.3 MHz bump
# when the OnStep USB was busy; any FIXED clock (powersave or performance) -> 0 %. powersave is the coolest.
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo powersave > "$g"; done'

[Install]
WantedBy=multi-user.target
