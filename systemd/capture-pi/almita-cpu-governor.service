[Unit]
Description=ALMITA capture Pi: fixed CPU clock (powersave, 600 MHz on a Pi 4) - coolest in the box, fewer clock changes
# 2026-11-02 indoor tests in the box: pulses in MAIN (7-8 % of the FFT frames, a ~1421.3 MHz bump with the OnStep
# USB busy) vanished right when the clock was fixed - but they came back after a reboot WITH the fixed clock and
# then stopped on their own: the pulses are intermittent and the clock is NOT proven to be their cause. Kept because
# it is harmless: ~60 C idle at load ~0.2 with rtl_tcp + INDI + KStars.
After=sysinit.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo powersave > "$g"; done'

[Install]
WantedBy=multi-user.target
